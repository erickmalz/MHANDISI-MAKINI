# Copy to .env and fill BETTER_AUTH_SECRET. The DATABASE_URLs match
# docker-compose.yml + docker/postgres/init/00-roles.sql out of the box.

# Migrations, drizzle-kit, better-auth's adapter — the schema owner.
DATABASE_URL="postgresql://mhandisi_owner:owner_local_dev@localhost:5432/mhandisi"

# The Next.js runtime pool. Non-owner, row-level-security-bound.
APP_DATABASE_URL="postgresql://app_runtime:app_local_dev@localhost:5432/mhandisi"

# Session-less maintenance jobs (BYPASSRLS). Unused until Phase 4.
MAINTENANCE_DATABASE_URL="postgresql://maintenance:maintenance_local_dev@localhost:5432/mhandisi"

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Transactional email (Resend). Leave RESEND_API_KEY empty in development —
# verification / reset links are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Mhandisi Makini <no-reply@localhost>"
