# Copy to .env and fill BETTER_AUTH_SECRET. The DATABASE_URLs match
# docker-compose.yml + docker/postgres/init/00-roles.sql out of the box.
#
# To point at a Supabase project instead (ADR 0006): after running
# `scripts/bootstrap-db.ts` against the project (see that script's header),
# swap host/user/password below for the three roles it created, keep the
# database name as `postgres` (not `mhandisi`), and add `?sslmode=no-verify`.
# (Not `sslmode=require` — recent `pg`/`pg-connection-string` treat `require`
# as full certificate-chain verification, which fails against Supabase's
# pooler with "self-signed certificate in certificate chain". `no-verify`
# keeps the connection encrypted without that check, matching what `require`
# used to mean.)
#
# Most networks need Supabase's Session pooler (IPv4-reachable) rather than
# its plain direct connection (IPv6-only) — over the pooler, the username is
# `<role>.<project-ref>`, e.g.:
# postgresql://app_runtime.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
# (If your network has working IPv6, the plain direct connection works too:
# postgresql://app_runtime:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=no-verify )
#
# Either way, never use the *Transaction* pooler (port 6543) — RLS here
# relies on `SET LOCAL` inside a session, which that pooler mode breaks.

# Migrations, drizzle-kit, better-auth's adapter — the schema owner.
DATABASE_URL="postgresql://mhandisi_owner:owner_local_dev@localhost:5432/mhandisi"

# The Next.js runtime pool. Non-owner, row-level-security-bound.
APP_DATABASE_URL="postgresql://app_runtime:app_local_dev@localhost:5432/mhandisi"

# Session-less maintenance jobs (BYPASSRLS). Unused until Phase 4.
MAINTENANCE_DATABASE_URL="postgresql://maintenance:maintenance_local_dev@localhost:5432/mhandisi"

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Transactional email (Resend). Leave RESEND_API_KEY empty in development —
# verification / reset links are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Mhandisi Makini <no-reply@localhost>"
